<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">


    <persistence-unit name="itmd4515testPU" transaction-type="RESOURCE_LOCAL">

        <class>edu.iit.sat.itmd4515.vgangaswamy.domain.Bakery</class>
        <class>edu.iit.sat.itmd4515.vgangaswamy.domain.CustomerOrder</class>
        <class>edu.iit.sat.itmd4515.vgangaswamy.domain.Ingredient</class>
        <class>edu.iit.sat.itmd4515.vgangaswamy.domain.Customer</class>
        <class>edu.iit.sat.itmd4515.vgangaswamy.domain.Inventory</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/itmd4515?useSSL=false"/>
            <property name="jakarta.persistence.jdbc.user" value="itmd4515"/>
            <property name="jakarta.persistence.jdbc.password" value="itmd4515"/>
            <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>
            <property name="eclipselink.logging.parameters" value="true"/>

            <!-- Turn off SQL logging -->
            <property name="eclipselink.logging.level" value="WARNING"/>

            <!-- Optional: Turn off additional detailed SQL logs -->
            <property name="eclipselink.logging.level.sql" value="OFF"/>
            <property name="eclipselink.logging.level.transaction" value="OFF"/>
        </properties>

    </persistence-unit>
</persistence>
